@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@XXWIDGETS_BUILD_INSPECTORS@)
    if(UNIX)
        find_dependency(Threads)
    endif()
    if(NOT TARGET xxfclib::xxfclib)
        find_package(xxfclib CONFIG QUIET)
        if(NOT TARGET xxfclib::xxfclib)
            if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/../xxfclib/xxfclibTargets.cmake")
                include("${CMAKE_CURRENT_LIST_DIR}/../xxfclib/xxfclibTargets.cmake")
            else()
                set(xxwidgets_FOUND FALSE)
                set(xxwidgets_NOT_FOUND_MESSAGE "xxwidgets::inspect requires the installed xxfclib format library")
                return()
            endif()
        endif()
    endif()
endif()
set(xxwidgets_inspect_FOUND @XXWIDGETS_BUILD_INSPECTORS@)
if(@XXWIDGETS_BUILD_SETTINGS@ AND UNIX)
    find_dependency(Threads)
endif()
if("@_xxwidgets_native@" STREQUAL "gtk3")
    find_dependency(PkgConfig)
    pkg_check_modules(XXWIDGETS_GTK3 REQUIRED IMPORTED_TARGET gtk+-3.0>=3.16)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/xxwidgetsTargets.cmake")
check_required_components(xxwidgets)
